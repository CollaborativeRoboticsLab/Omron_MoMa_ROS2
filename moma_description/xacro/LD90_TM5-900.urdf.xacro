<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="tm5-900">

  <!-- Existing args -->
  <xacro:arg name="ns" default="" />
  <xacro:arg name="color" default="none" />
  <xacro:arg name="trans_hw_iface" default="hardware_interface/PositionJointInterface" />
  <xacro:arg name="gripper" default="none" />
  <xacro:arg name="arm_prefix" default="tm_" />
  <xacro:arg name="base_prefix" default=""/>
  <xacro:arg name="arm_mount_xyz" default="-0.25 0 0.75"/>
  <xacro:arg name="arm_mount_rpy" default="0 0 1.57"/>

  <!-- Set this to the actual base link name produced by tm_description (see notes below) -->
  <xacro:arg name="arm_base_link" default="base"/>

  <!-- Includes -->
  <xacro:include filename="$(find amr_description)/xacro/ld90.urdf.xacro"/>
  <xacro:include filename="$(find tm_description)/xacro/macro.gazebo.xacro" />
  <xacro:include filename="$(find tm_description)/xacro/macro.transmission.xacro" />
  <xacro:include filename="$(find tm_description)/xacro/macro.materials.xacro" />
  <xacro:include filename="$(find tm_description)/xacro/macro.tm5-900-nominal.urdf.xacro" />

  <!-- LD90 mobile base as root (no world joint, keep it mobile) -->
  <xacro:ld90 prefix="$(arg base_prefix)" mesh_pkg="amr_description"/>

  <!-- TM5-900 stack (gazebo/transmission/materials) -->
  <xacro:tmr_gazebo ns="$(arg ns)" prefix="$(arg arm_prefix)" />
  <xacro:tmr_transmission prefix="$(arg arm_prefix)" hw_iface="$(arg trans_hw_iface)" />
  <xacro:tmr_materials/>

  <!-- Arm geometry -->
  <xacro:property name="color" value="$(arg color)"/>
  <xacro:if value="${color == 'none'}">
    <xacro:tm5-900 ns="$(arg ns)" prefix="$(arg arm_prefix)" />
  </xacro:if>
  <xacro:unless value="${color == 'none'}">
    <xacro:tm5-900 ns="$(arg ns)" prefix="$(arg arm_prefix)" color="${color}" format="stl" />
  </xacro:unless>

  <!-- Optional gripper -->
  <xacro:property name="gripper" value="$(arg gripper)"/>
  <xacro:if value="${gripper == 'robotiq_2f-85'}">
    <xacro:include filename="$(find gripper_description)/xacro/robotiq/2f-85/robotiq_2f.urdf.xacro" />
    <xacro:robotiq_2f prefix="$(arg arm_prefix)"/>
  </xacro:if>

  <!-- Mount TM5-900 base to LD90 base_link -->
  <joint name="ld90_to_tm5_mount" type="fixed">
    <parent link="$(arg base_prefix)base_link"/>
    <child link="$(arg arm_prefix)$(arg arm_base_link)"/>
    <origin xyz="$(arg arm_mount_xyz)" rpy="$(arg arm_mount_rpy)"/>
  </joint>

</robot>
